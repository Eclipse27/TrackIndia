{
  "name": "backend",
  "version": "1.0.0",
  "description": "TrackIndia Backend — Express + Socket.io",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --testTimeout=10000 --forceExit",
    "test:unit": "jest tests/unit --testTimeout=10000 --forceExit",
    "test:integration": "jest tests/integration --testTimeout=10000 --forceExit",
    "test:uat": "jest tests/uat --testTimeout=10000 --forceExit",
    "test:verbose": "jest --verbose --testTimeout=10000 --forceExit",
    "test:coverage": "jest --coverage --testTimeout=10000 --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "verbose": true,
    "setupFiles": ["./tests/setup.js"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.0"
  }
}
